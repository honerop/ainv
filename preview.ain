# AINV animated SVG director.
# All vector graphics, timelines, easing, scenes, and SVG serialization are Ain.
# No Python, FFmpeg, browser automation, or changes to the Ain compiler.
# Usage: AIN_VIDEO_SPEC=examples/showcase.json AIN_VIDEO_PREVIEW=showcase.svg ainc run preview.ain

sval obj key fallback = if hasfield obj key astext field obj key fallback
ival obj key fallback = if hasfield obj key asint field obj key fallback
object_at source key = if hasfield source key field source key record _
j3 a b c = concat concat a b c
j4 a b c d = concat j3 a b c d
j5 a b c d e = concat j4 a b c d e
esc text = replace replace replace replace text "&" "&amp;" "<" "&lt;" ">" "&gt;" "\"" "&quot;"
attr key value = j4 " " key "=\"" concat value "\""
nattr key number = attr key str number
open name attrs = j4 "<" name attrs ">"
close name = j3 "</" name ">"
node name attrs children = j3 open name attrs children close name
empty name attrs = j4 "<" name attrs "/>"
pad3 value = if < value 10 j3 "00" str value "" if < value 100 concat "0" str value str value
seconds ms = j4 str / ms 1000 "." pad3 % ms 1000 "s"

# Named design-system colors prevent invalid/unescaped user-supplied SVG attributes.
palette value = if == value "cyan" "#48dff0" if == value "ice" "#b9f9ff" if == value "white" "#f1f7ff" if == value "muted" "#8b9cb2" if == value "navy" "#101c34" if == value "ink" "#080d19" if == value "panel" "#17253b" if == value "slate" "#324059" if == value "blue" "#6189ff" if == value "purple" "#b592ff" if == value "rose" "#ff8da9" if == value "red" "#ff7088" if == value "orange" "#ffbd75" if == value "yellow" "#ffe18c" if == value "green" "#7df1bc" if == value "black" "#000000" "#48dff0"

anchor name = if == name "middle" "middle" if == name "end" "end" "start"
weight name = if == name "bold" "700" if == name "light" "300" "500"
initial shape key = ival object_at shape "from" key ival shape key 0
target shape key = ival object_at shape "to" key ival shape key 0
ease_attr shape = if == sval shape "ease" "smooth" "smooth" " calcMode=\"spline\" keySplines=\"0.42 0 0.18 1\"" ""
tween shape key begin duration = if == initial shape key target shape key "" empty "animate" j5 attr "attributeName" key nattr "from" initial shape key nattr "to" target shape key attr "begin" seconds begin concat attr "dur" seconds duration concat " fill=\"freeze\"" ease_attr shape
motion shape fields begin duration index result = if >= index listlen fields result motion shape fields begin duration + index 1 concat result tween shape listat fields index begin duration
geom shape fields begin duration = motion shape split fields "," begin duration 0 ""

paint shape = j3 attr "fill" palette sval shape "fill" "cyan" attr "opacity" seconds_opacity shape ""
seconds_opacity shape = if >= ival shape "opacity" 100 100 "1" if < ival shape "opacity" 100 0 "0" j3 "0." pad2 ival shape "opacity" 100 ""
pad2 value = if < value 10 concat "0" str value str value
stroke shape = j3 attr "stroke" palette sval shape "stroke" "cyan" nattr "stroke-width" ival shape "stroke_width" 3 " stroke-linecap=\"round\" stroke-linejoin=\"round\""
bg scene width height = empty "rect" j5 nattr "x" 0 nattr "y" 0 nattr "width" width nattr "height" height attr "fill" palette sval scene "background" "ink"

rectangle shape begin duration = node "rect" j5 nattr "x" initial shape "x" nattr "y" initial shape "y" nattr "width" initial shape "width" nattr "height" initial shape "height" concat paint shape nattr "rx" ival shape "radius" 0 geom shape "x,y,width,height" begin duration
round_shape shape begin duration = node "circle" j4 nattr "cx" initial shape "cx" nattr "cy" initial shape "cy" nattr "r" initial shape "r" paint shape geom shape "cx,cy,r" begin duration
line_shape shape begin duration = node "line" j5 nattr "x1" initial shape "x1" nattr "y1" initial shape "y1" nattr "x2" initial shape "x2" nattr "y2" initial shape "y2" stroke shape geom shape "x1,y1,x2,y2" begin duration
arrow_shape shape begin duration = node "line" j5 nattr "x1" initial shape "x1" nattr "y1" initial shape "y1" nattr "x2" initial shape "x2" nattr "y2" initial shape "y2" concat stroke shape " marker-end=\"url(#ainv-arrow)\"" geom shape "x1,y1,x2,y2" begin duration

# Unicode text, including mathematical symbols, renders using system fonts.
text_shape shape begin duration = node "text" j5 nattr "x" initial shape "x" nattr "y" initial shape "y" nattr "font-size" ival shape "font_size" 42 attr "text-anchor" anchor sval shape "anchor" "start" concat attr "fill" palette sval shape "fill" "white" attr "font-weight" weight sval shape "weight" "normal" j3 esc sval shape "value" "" geom shape "x,y" begin duration ""

as_point value = j3 str ival value "x" 0 "," str ival value "y" 0
point_str points index result = if >= index size points result point_str points + index 1 j3 result if == index 0 "" " " as_point get points index
polyline shape begin duration = node "polyline" j5 attr "points" point_str field shape "points" 0 "" stroke shape " fill=\"none\"" attr "stroke-dasharray" "2400" attr "stroke-dashoffset" "2400" empty "animate" j5 attr "attributeName" "stroke-dashoffset" attr "from" "2400" attr "to" "0" attr "begin" seconds begin concat attr "dur" seconds duration concat " fill=\"freeze\"" ease_attr shape

shape_svg shape begin duration = if == sval shape "kind" "" "rect" rectangle shape begin duration if == sval shape "kind" "" "circle" round_shape shape begin duration if == sval shape "kind" "" "text" text_shape shape begin duration if == sval shape "kind" "" "line" line_shape shape begin duration if == sval shape "kind" "" "arrow" arrow_shape shape begin duration if == sval shape "kind" "" "polyline" polyline shape begin duration ""
shapes_svg shapes begin duration index result = if >= index size shapes result shapes_svg shapes begin duration + index 1 concat result shape_svg get shapes index begin duration

span scene fps = if hasfield scene "frames" ival scene "frames" 1 * ival scene "duration" 1 fps
scene_millis scene fps = / * span scene fps 1000 fps
scene_svg scene begin fps width height = node "g" " opacity=\"0\"" concat empty "set" j4 attr "attributeName" "opacity" attr "to" "1" attr "begin" seconds begin concat attr "dur" seconds scene_millis scene fps " fill=\"remove\"" j3 bg scene width height shapes_svg field scene "elements" begin scene_millis scene fps 0 "" ""
render_scenes scenes fps width height index begin output = if >= index size scenes output render_scenes scenes fps width height + index 1 + begin scene_millis get scenes index fps concat output scene_svg get scenes index begin fps width height

arrow_def _ = "<defs><marker id=\"ainv-arrow\" markerWidth=\"10\" markerHeight=\"10\" refX=\"9\" refY=\"3\" orient=\"auto\"><path d=\"M0,0 L0,6 L9,3 Z\" fill=\"#48dff0\"/></marker></defs>"
svg_document project = node "svg" j5 attr "xmlns" "http://www.w3.org/2000/svg" attr "width" str ival project "width" 1280 attr "height" str ival project "height" 720 attr "viewBox" j4 "0 0 " str ival project "width" 1280 " " str ival project "height" 720 attr "role" "img" j3 arrow_def _ render_scenes field project "scenes" max 1 ival project "fps" 30 ival project "width" 1280 ival project "height" 720 0 0 "" ""

project = json fsread environ "AIN_VIDEO_SPEC"
fswrite environ "AIN_VIDEO_PREVIEW" svg_document project
print concat "Created animated SVG: " environ "AIN_VIDEO_PREVIEW"
