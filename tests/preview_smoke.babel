# Animated SVG integration check, written in Babel.
require valid = / 1 if valid 1 0
markup = fsread "showcase.svg"
print require starts markup "<svg "
print require contains markup "viewBox="
print require contains markup "keySplines="
print require contains markup "<animate "
print require contains markup "<polyline "
print require contains markup "<text "
print require contains markup "ainv-arrow"
print require contains markup "Explain ideas"
print require contains markup "growth  =  x²"
print require contains markup "02 / IDEAS INTO EXPLANATIONS"
print require contains markup "</svg>"
print "Animated SVG showcase passed"
