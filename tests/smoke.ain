# Standalone Ain-only video smoke test.
# Run after generating explainer.y4m from examples/explainer.json.
# A failed assertion triggers an integer divide-by-zero error and exits nonzero.

require valid = / 1 if valid 1 0
data = fsread "explainer.y4m"
header = "YUV4MPEG2 W96 H64 F8:1 Ip A1:1 C420jpeg\n"
print require starts data header
print require == listlen split data "FRAME\n" 17
print require == len data + len header * 16 + 6 / * * 96 64 3 2
print "Ain video smoke test passed"
