# AinV director. All project logic, narration scheduling and scene rendering live in Ain.
# External tools only encode H.264/AAC, rasterize SVG, and provide Edge speech.

sv o k d = if hasfield o k astext field o k d
iv o k d = if hasfield o k asint field o k d
j3 a b c = concat concat a b c
j4 a b c d = concat j3 a b c d
j5 a b c d e = concat j4 a b c d e
j6 a b c d e f = concat j5 a b c d e f
esc s = replace replace replace replace s "&" "&amp;" "<" "&lt;" ">" "&gt;" "\"" "&quot;"
att k v = j4 " " k "=\"" concat v "\""
nat k n = att k str n
palette v = if == v "cyan" "#48dff0" if == v "ice" "#b9f9ff" if == v "white" "#f1f7ff" if == v "muted" "#8b9cb2" if == v "navy" "#101c34" if == v "ink" "#080d19" if == v "panel" "#17253b" if == v "slate" "#324059" if == v "blue" "#6189ff" if == v "purple" "#b592ff" if == v "rose" "#ff8da9" if == v "red" "#ff7088" if == v "orange" "#ffbd75" if == v "yellow" "#ffe18c" if == v "green" "#7df1bc" if == v "black" "#000000" "#48dff0"
clr o k d = att k palette sv o k d
a1 a = push array _ boxstr a
a2 a b = push a1 a boxstr b
a3 a b c = push a2 a b boxstr c
a4 a b c d = push a3 a b c boxstr d
a5 a b c d e = push a4 a b c d boxstr e
a6 a b c d e f = push a5 a b c d e boxstr f
a7 a b c d e f g = push a6 a b c d e f boxstr g
ap a b = push a boxstr b
ok p = assert and asbool field p "ok" == asint field field p "value" "code" 0
pad2 n = if < n 10 concat "0" str n str n
pad3 n = if < n 10 concat "00" str n if < n 100 concat "0" str n str n
pad6 n = if < n 10 concat "00000" str n if < n 100 concat "0000" str n if < n 1000 concat "000" str n if < n 10000 concat "00" str n if < n 100000 concat "0" str n str n
framename i ext = concat concat "frame-" pad6 i ext
workpath name = pathjoin environ "AINV_WORK" name
svgfile i = workpath framename i ".svg"
pngfile i = workpath framename i ".png"
voicefile i = workpath concat concat "voice-" pad6 i ".mp3"
now_text a = if hasfield a "narration" sv a "narration" "" ""
ttsargs a = a7 "--voice" sv a "voice" "en-US-AndrewNeural" concat "--rate=" sv a "voice_rate" "-5%" "--text" now_text a "--write-media" voicefile iv a "index" 0
synth a = if == now_text a "" _ ok processrun environ "AINV_EDGE_TTS" ttsargs a
ffprobe_args filename = a7 "-v" "error" "-show_entries" "format=duration" "-of" "default=noprint_wrappers=1:nokey=1" filename
msec text = + * 1000 num before trim text "." num strjoin listtake split concat after trim text "." "000" "" 3 ""
probelen filename = msec astext field field processrun environ "AINV_FFPROBE" ffprobe_args filename "value" "stdout"
audioms scene = if == now_text scene "" 0 probelen voicefile iv scene "index" 0
index_scene s = put get field s "scenes" iv s "i" 0 "index" boxint iv s "i" 0
index_advance s scene = put put s "indexed" push field s "indexed" scene "i" boxint + iv s "i" 0 1
index_step s = index_advance s index_scene s
scene_frames scene fps = if hasfield scene "frames" iv scene "frames" fps * fps iv scene "duration" 4
timeline_frames scene fps = max 1 max scene_frames scene fps / * + audioms scene 350 fps 1000
time_scene s = get field s "indexed" iv s "i" 0
time_advance s scene count = put put put s "timeline" push field s "timeline" put put scene "frames" boxint count "start_frame" boxint iv s "cursor" 0 "cursor" boxint + iv s "cursor" 0 count "i" boxint + iv s "i" 0 1
time_step s = time_advance s time_scene s timeline_frames time_scene s iv s "fps" 30
locate scenes frame index = if < frame + iv get scenes index "start_frame" 0 iv get scenes index "frames" 1 pair get scenes index boxint - frame iv get scenes index "start_frame" 0 locate scenes frame + index 1
desc s found = put put put put put record _ "scene" get found 0 "local" get found 1 "index" boxint iv s "i" 0 "width" field s "width" "height" field s "height"
frame_step_found s found = put put s "frames" push field s "frames" desc s found "i" boxint + iv s "i" 0 1
frame_step s = frame_step_found s locate field s "timeline" iv s "i" 0 0

baseval shape key d = iv shape key d
fromval shape key d = if hasfield shape "from" iv field shape "from" key baseval shape key d baseval shape key d
toval shape key d = if hasfield shape "to" iv field shape "to" key baseval shape key d baseval shape key d
pct f total = if <= total 1 100 / * f 100 - total 1
localpct shape p = if <= iv shape "end_percent" 100 iv shape "start_percent" 0 if >= p iv shape "end_percent" 100 100 0 clamp / * - p iv shape "start_percent" 0 100 - iv shape "end_percent" 100 iv shape "start_percent" 0 0 100
smooth p = / * p * p - 300 * 2 p 10000
interp shape key def p = + fromval shape key def / * - toval shape key def fromval shape key def if == sv shape "ease" "" "smooth" smooth p p 100
animated shape key def frame frames = interp shape key def localpct shape pct frame frames
paint shape = clr shape "fill" "cyan"
alpha shape frame frames = if >= animated shape "opacity" 100 frame frames 100 att "opacity" "1" att "opacity" j3 "0." pad2 animated shape "opacity" 100 frame frames ""
stroke shape = j3 clr shape "stroke" "cyan" nat "stroke-width" iv shape "stroke_width" 3 " stroke-linecap=\"round\" stroke-linejoin=\"round\""
text_shape s f total = j6 "<text" nat "x" animated s "x" 0 f total nat "y" animated s "y" 0 f total nat "font-size" iv s "font_size" 42 att "font-weight" if == sv s "weight" "" "bold" "700" "500" concat clr s "fill" "white" j4 " font-family=\"DejaVu Sans, sans-serif\"" alpha s f total ">" concat esc sv s "value" "" "</text>"
rect_shape s f total = concat j6 "<rect" nat "x" animated s "x" 0 f total nat "y" animated s "y" 0 f total nat "width" max 0 animated s "width" 0 f total nat "height" max 0 animated s "height" 0 f total nat "rx" iv s "radius" 0 j3 paint s alpha s f total "/>"
circle_shape s f total = j5 "<circle" nat "cx" animated s "cx" 0 f total nat "cy" animated s "cy" 0 f total nat "r" max 0 animated s "r" 0 f total concat paint s concat alpha s f total "/>"
line_shape s f total = concat j6 "<line" nat "x1" animated s "x1" 0 f total nat "y1" animated s "y1" 0 f total nat "x2" animated s "x2" 0 f total nat "y2" animated s "y2" 0 f total stroke s concat alpha s f total if == sv s "kind" "" "arrow" " marker-end=\"url(#ain-arrow)\"/>" "/>"
cx shape x100 = + iv shape "x" 0 / * iv shape "width" 1 - x100 * 100 iv shape "x_min" -5 * 100 - iv shape "x_max" 5 iv shape "x_min" -5
cy shape y100 = - + iv shape "y" 0 iv shape "height" 1 / * iv shape "height" 1 - y100 * 100 iv shape "y_min" -3 * 100 - iv shape "y_max" 3 iv shape "y_min" -3
axisline x1 y1 x2 y2 c = j6 "<line" nat "x1" x1 nat "y1" y1 nat "x2" x2 nat "y2" y2 j3 " stroke=\"" c "\" stroke-width=\"2\" opacity=\"0.7\"/>"
axes_shape s = concat axisline cx s 0 iv s "y" 0 cx s 0 + iv s "y" 0 iv s "height" 1 palette sv s "stroke" "slate" axisline iv s "x" 0 cy s 0 + iv s "x" 0 iv s "width" 1 cy s 0 palette sv s "stroke" "slate"
phase x = % + % x 628 628 628
sinpos n = / * 1600 * n - 314 n - * 5 * 314 314 * 4 * n - 314 n
sin100 x = if <= phase x 314 sinpos phase x neg sinpos - phase x 314
plotx s i = + * 100 iv s "x_min" -5 / * * 100 - iv s "x_max" 5 iv s "x_min" -5 i 180
plot_y s x = if == sv s "function" "quadratic" "sin" + * iv s "a" 1 sin100 + x * 100 iv s "b" 0 * 100 iv s "c" 0 if == sv s "function" "quadratic" "cos" + * iv s "a" 1 sin100 + x + 157 * 100 iv s "b" 0 * 100 iv s "c" 0 if == sv s "function" "quadratic" "linear" + * iv s "a" 1 x * 100 iv s "c" 0 if == sv s "function" "quadratic" "cubic" + / * iv s "a" 1 * / * x x 100 x 100 + * iv s "b" 0 x * 100 iv s "c" 0 + + / * iv s "a" 1 * x x 100 * iv s "b" 0 x * 100 iv s "c" 0
plot_points s i last text = if > i last text plot_points s + i 1 last j5 text str cx s plotx s i "," str cy s plot_y s plotx s i " "
plot_shape s frame total = j4 "<polyline fill=\"none\" points=\"" plot_points s 0 / * 180 localpct s pct frame total 100 "" "\"" j3 stroke s alpha s frame total "/>"
point p = j3 str iv p "x" 0 "," str iv p "y" 0
poly_points ps i result = if >= i size ps result poly_points ps + i 1 j3 result point get ps i " "
poly_shape s = j4 "<polyline fill=\"none\" points=\"" poly_points field s "points" 0 "" concat "\"" stroke s "/>"
shape_svg s frame total = if == sv s "kind" "" "rect" rect_shape s frame total if == sv s "kind" "" "circle" circle_shape s frame total if == sv s "kind" "" "line" line_shape s frame total if == sv s "kind" "" "arrow" line_shape s frame total if == sv s "kind" "" "text" text_shape s frame total if == sv s "kind" "" "axes" axes_shape s if == sv s "kind" "" "plot" plot_shape s frame total if == sv s "kind" "" "polyline" poly_shape s ""
append_shape acc shape = put acc "svg" boxstr concat astext field acc "svg" shape_svg shape iv acc "local" 0 iv acc "total" 1
scene_svg meta = astext field fold "append_shape" put put put record _ "svg" boxstr "" "local" field meta "local" "total" field field meta "scene" "frames" field field meta "scene" "elements" "svg"
svg_at meta = j6 "<svg xmlns=\"http://www.w3.org/2000/svg\"" nat "width" iv meta "width" 1280 nat "height" iv meta "height" 720 ">" j3 "<defs><marker id=\"ain-arrow\" markerWidth=\"10\" markerHeight=\"10\" refX=\"9\" refY=\"3\" orient=\"auto\"><path d=\"M0,0 L0,6 L9,3 Z\" fill=\"#48dff0\"/></marker></defs>" j4 "<rect width=\"100%\" height=\"100%\" fill=\"" palette sv field meta "scene" "background" "ink" "\"/>" "" scene_svg meta "</svg>"
write_frame meta = fswrite svgfile iv meta "index" 0 svg_at meta
raster_frame meta = ok processrun environ "AINV_RSVG" a4 "--output" pngfile iv meta "index" 0 svgfile iv meta "index" 0 "--keep-aspect-ratio"
ff_video_args fps = ap ap ap ap ap ap ap ap ap ap ap ap ap ap ap ap a1 "-y" "-hide_banner" "-loglevel" "error" "-framerate" str fps "-i" workpath "frame-%06d.png" "-c:v" "libx264" "-pix_fmt" "yuv420p" "-crf" "17" "-movflags" "+faststart" workpath "silent.mp4"
seconds_ms ms = j3 str / ms 1000 "." pad3 % ms 1000
audio_indexed state = get field state "timeline" iv state "i" 0
audio_next state = put state "i" boxint + iv state "i" 0 1
voice_filter state scene = j6 "[" str iv state "input" 2 ":a]aresample=48000,adelay=" str / * iv scene "start_frame" 0 1000 iv state "fps" 30 concat ":all=1[v" str iv state "input" 2 "];"
audio_with_args state scene = put state "args" ap ap field state "args" "-i" voicefile iv scene "index" 0
audio_with_filter state scene = put state "filters" boxstr concat sv state "filters" "" voice_filter state scene
audio_with_refs state = put state "refs" boxstr concat sv state "refs" "[sil]" j3 "[v" str iv state "input" 2 "]"
audio_add state scene = put audio_with_refs audio_with_filter audio_with_args state scene scene "input" boxint + iv state "input" 2 1
audio_step state = audio_next if == now_text audio_indexed state "" state audio_add state audio_indexed state
filter_graph state = j4 sv state "filters" "" "[1:a]volume=0[sil];" sv state "refs" "[sil]" concat "amix=inputs=" concat str - iv state "input" 2 1 ":duration=first:dropout_transition=0,aresample=48000,alimiter=limit=0.95[aout]"
sound_base duration = ap ap ap ap ap ap ap ap ap ap ap a1 "-y" "-hide_banner" "-loglevel" "error" "-i" workpath "silent.mp4" "-f" "lavfi" "-t" seconds_ms duration "-i" "anullsrc=r=48000:cl=stereo"
sound_tail args state duration output = ap ap ap ap ap ap ap ap ap ap ap ap ap ap ap args "-filter_complex" filter_graph state "-map" "0:v:0" "-map" "[aout]" "-c:v" "copy" "-c:a" "aac" "-b:a" "192k" "-t" seconds_ms duration output
sound_args state duration output = sound_tail field state "args" state duration output
copy_args out = a6 "-y" "-i" workpath "silent.mp4" "-c" "copy" out
srt_time ms = j6 pad2 / ms 3600000 ":" pad2 % / ms 60000 60 ":" pad2 % / ms 1000 60 concat "," pad3 % ms 1000
caption_text scene = sv scene "caption" now_text scene
sub_step state = put put state "text" boxstr concat sv state "text" "" j6 str + iv state "i" 0 1 "\n" srt_time / * iv audio_indexed state "start_frame" 0 1000 iv state "fps" 30 " --> " srt_time / * + iv audio_indexed state "start_frame" 0 iv audio_indexed state "frames" 1 1000 iv state "fps" 30 concat "\n" concat caption_text audio_indexed state "\n\n" "i" boxint + iv state "i" 0 1

args = argv _
input_file = if > size args 0 astext get args 0 environ "AINV_DEFAULT_SPEC"
output_file = if > size args 1 astext get args 1 "showcase.mp4"
project = json fsread input_file
scenes = field project "scenes"
fps = iv project "fps" 30
indexed_state = iterate "index_step" size scenes put put put record _ "scenes" scenes "i" boxint 0 "indexed" array _
indexed = field indexed_state "indexed"
print "ainv: synthesizing narrated scenes with Edge TTS"
each "synth" indexed
timeline_state = iterate "time_step" size indexed put put put put put record _ "indexed" indexed "timeline" array _ "cursor" boxint 0 "i" boxint 0 "fps" boxint fps
timeline = field timeline_state "timeline"
total_frames = iv timeline_state "cursor" 0
assert > total_frames 0
assert <= total_frames 18000
assert asbool field fsmkdir environ "AINV_WORK" "ok"
print concat "ainv: preparing vector frames: " str total_frames
frame_state = iterate "frame_step" total_frames put put put put put put record _ "timeline" timeline "frames" array _ "i" boxint 0 "width" boxint iv project "width" 1280 "height" boxint iv project "height" 720 "fps" boxint fps
each "write_frame" field frame_state "frames"
print "ainv: rasterizing SVG with librsvg"
each "raster_frame" field frame_state "frames"
print "ainv: encoding H.264 MP4"
ok processrun environ "AINV_FFMPEG" ff_video_args fps
length_ms = / * total_frames 1000 fps
audio_state = iterate "audio_step" size timeline put put put put put put put record _ "timeline" timeline "i" boxint 0 "input" boxint 2 "args" sound_base length_ms "filters" boxstr "" "refs" boxstr "[sil]" "fps" boxint fps
print "ainv: exporting audio and subtitles"
ok processrun environ "AINV_FFMPEG" if > iv audio_state "input" 2 2 sound_args audio_state length_ms output_file copy_args output_file
subtitles = iterate "sub_step" size timeline put put put put record _ "timeline" timeline "text" boxstr "" "i" boxint 0 "fps" boxint fps
fswrite replace output_file ".mp4" ".srt" sv subtitles "text" ""
print concat "ainv: created " output_file
